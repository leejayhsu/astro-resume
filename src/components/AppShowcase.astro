---
interface Props {
  title: string;
  description: string;
  href: string;
  screenshot: string;
  screenshotAlt: string;
  tech: string[];
}

const { title, description, href, screenshot, screenshotAlt, tech } =
  Astro.props;
const hostname = new URL(href).hostname;
---

<article class="app-showcase">
  <a
    href={href}
    class="app-preview-link"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Open ${title}`}
  >
    <div class="app-browser-bar" aria-hidden="true">
      <span class="app-browser-dots"><i></i><i></i><i></i></span>
      <span class="app-browser-url">{hostname}</span>
    </div>
    <div class="app-preview-image-wrap">
      <img
        src={screenshot}
        alt={screenshotAlt}
        class="app-preview-image"
        width="1440"
        height="900"
        loading="lazy"
        decoding="async"
      />
      <span class="app-preview-action" aria-hidden="true">
        Open app
        <svg viewBox="0 0 16 16" focusable="false">
          <path d="M5 11 11 5M6 5h5v5"></path>
        </svg>
      </span>
    </div>
  </a>
  <div class="app-showcase-content">
    <div class="app-showcase-heading">
      <h3>{title}</h3>
    </div>
    <p>{description}</p>
    <ul class="chips-container app-tech-list" aria-label="Technologies">
      {tech.map((item) => <li class="single-chip small-chip">{item}</li>)}
    </ul>
  </div>
</article>
